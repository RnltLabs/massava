# Massava - Environment Variables Example
# Copy this to .env and fill in your values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/massava_dev"

# Email (Resend - required for email verification)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@massava.app"

# Cron Job Secret (required for automated tasks)
# Generate with: openssl rand -base64 32
# Used to secure: booking reminders, review requests, data retention
CRON_SECRET="your-cron-secret-here"

# Authentication (NextAuth.js)
AUTH_SECRET="your-auth-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_BASEPATH="/api/auth"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Password Reset Token Expiry (in hours)
PASSWORD_RESET_TOKEN_EXPIRY_HOURS="1"

# Next.js
NODE_ENV="development"

# Application URL (required for QStash webhooks and email links)
# Local: http://localhost:3000
# Staging: https://staging.massava.app
# Production: https://massava.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Coming Soon Mode (set to "true" to show Coming Soon page instead of full app)
NEXT_PUBLIC_SHOW_COMING_SOON="false"

# Upstash Redis (for session caching and rate limiting)
# Get credentials from: https://console.upstash.com/
# Phase 2: Used for session caching to reduce auth latency by 94%
UPSTASH_REDIS_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_TOKEN="your-token-here"

# Google Analytics (optional - for website analytics with consent mode)
# Get measurement ID from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Maps API (required for location settings)
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable APIs: Maps JavaScript API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Health Data Encryption (GDPR Art. 9 Compliance)
# Generate with: openssl rand -hex 32
HEALTH_DATA_ENCRYPTION_KEY="your-64-character-hex-key-here"

# RabbitMQ (for background job processing)
# Phase 6: Used for async user sync to reduce OAuth latency by 73%
# Local: Use docker-compose (amqp://massava:massava_dev_password@localhost:5672)
# Production: Use managed service (CloudAMQP, AWS MQ, etc.)
RABBITMQ_URL="amqp://localhost:5672"

# ============================================
# GEOCODING SERVICE (Address Autocomplete)
# ============================================

# Radar API (Fallback Geocoding Provider)
# Primary provider: Photon (no API key required)
# Fallback provider: Radar (when Photon is unavailable)
# Get API keys from: https://radar.com/dashboard
# Secret Key: Server-side only, NEVER expose to browser
RADAR_SECRET_KEY="prj_live_sk_..."

# ============================================
# NOTIFICATION SYSTEM
# ============================================

# Upstash QStash (Serverless Message Queue)
# Get credentials from: https://console.upstash.com/ → QStash
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Firebase Admin SDK (Server-side push notifications)
# Download JSON from: Firebase Console → Project Settings → Service Accounts
# Paste the entire JSON as a single line
FIREBASE_ADMIN_SDK_JSON=''

# Firebase Client SDK (Public - used in browser)
# Get from: Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase VAPID Key (Web Push)
# Generate from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
