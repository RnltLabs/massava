generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  oldEmail  String
  newEmail  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("email_change_tokens")
}

model Studio {
  id              String               @id @default(cuid())
  name            String
  description     String?
  address         String
  city            String
  postalCode      String?
  phone           String
  email           String
  website         String? // Optional website URL
  openingHours    Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  latitude        Float?
  longitude       Float?
  capacity        Int                  @default(1)
  galleryImages   Json?
  logoUrl         String?
  blockedTimes    BlockedTime[]
  newBookings     NewBooking[]
  services        Service[]
  ownerships      StudioOwnership[]
  timeSlots       TimeSlot[]
  roleAssignments UserRoleAssignment[]
  favoritedBy     User[]               @relation("UserFavorites")

  @@index([city])
  @@index([latitude, longitude])
  @@map("studios")
}

model Service {
  id          String       @id @default(cuid())
  studioId    String
  name        String
  description String?
  price       Float
  duration    Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  newBookings NewBooking[]
  studio      Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  timeSlots   TimeSlot[]

  @@index([studioId])
  @@map("services")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  emailVerified       DateTime?
  password            String?
  name                String?
  phone               String?
  image               String?
  primaryRole         UserRole             @default(CUSTOMER)
  isActive            Boolean              @default(true)
  isSuspended         Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  deletionScheduledAt DateTime?
  auditLogs           AuditLog[]
  newAccounts         NewAccount[]
  newBookings         NewBooking[]
  newSessions         NewSession[]
  refreshTokens       RefreshToken[]
  ownedStudios        StudioOwnership[]
  roles               UserRoleAssignment[]
  newFavorites        Studio[]             @relation("UserFavorites")

  @@index([email])
  @@index([primaryRole])
  @@index([deletedAt])
  @@index([deletionScheduledAt])
  @@map("users")
}

model NewAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("new_accounts")
}

model NewSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("new_sessions")
}

model UserRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  role      UserRole
  studioId  String?
  grantedBy String?
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  studio    Studio?   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, studioId])
  @@index([userId])
  @@index([studioId])
  @@map("user_role_assignments")
}

model StudioOwnership {
  id          String    @id @default(cuid())
  userId      String
  studioId    String
  canTransfer Boolean   @default(false)
  invitedBy   String?
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?
  studio      Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studioId])
  @@index([userId])
  @@index([studioId])
  @@map("studio_ownership")
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

model NewBooking {
  id                       String        @id @default(cuid())
  studioId                 String
  serviceId                String?
  customerId               String?
  customerName             String
  customerEmail            String
  customerPhone            String?
  preferredDate            String
  preferredTime            String
  message                  String?
  explicitHealthConsent    Boolean?      @default(false)
  healthConsentGivenAt     DateTime?
  healthConsentText        String?
  healthConsentWithdrawnAt DateTime?
  status                   BookingStatus @default(PENDING)
  confirmedBy              String?
  confirmedAt              DateTime?
  cancelledBy              String?
  cancelledAt              DateTime?
  cancellationReason       String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  customer                 User?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service                  Service?      @relation(fields: [serviceId], references: [id])
  studio                   Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([serviceId])
  @@index([customerId])
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@index([studioId, status])
  @@index([studioId, preferredDate])
  @@index([studioId, status, confirmedAt])
  @@map("new_bookings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model TimeSlot {
  id          String   @id @default(cuid())
  studioId    String
  serviceId   String?
  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean  @default(true)
  isBooked    Boolean  @default(false)
  bookingId   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service? @relation(fields: [serviceId], references: [id])
  studio      Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([serviceId])
  @@index([startTime])
  @@index([isAvailable, isBooked])
  @@index([studioId, startTime, isAvailable])
  @@map("time_slots")
}

model BlockedTime {
  id        String   @id @default(cuid())
  studioId  String
  startTime DateTime
  endTime   DateTime
  reason    String?
  isAllDay  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@index([startTime])
  @@index([studioId, startTime])
  @@map("blocked_times")
}

model RefreshToken {
  id               String         @id @default(cuid())
  token            String         @unique
  userId           String
  family           String         @default(cuid())
  parentId         String?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
  revokedAt        DateTime?
  revocationReason String?
  revokedBy        String?
  parent           RefreshToken?  @relation("TokenChild", fields: [parentId], references: [id])
  children         RefreshToken[] @relation("TokenChild")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@index([parentId])
  @@index([family, revokedAt])
  @@map("refresh_tokens")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  STUDIO_OWNER
  CUSTOMER
  GUEST
}
