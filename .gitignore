# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
.env.test
.env.test.local
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase (sensitive credentials)
*-firebase-adminsdk*.json
GoogleService-Info.plist
google-services.json

# Generated service worker (contains Firebase config, generated from template)
public/firebase-messaging-sw.js

# Capacitor build outputs (native platforms)
ios/
android/

# RNLT Labs Config (symlinked, private)
.rnlt/
.claude/

# IDE
.vscode/
.idea/

/app/generated/prisma

# Backup and temporary files
*.bak
*.backup
*.old
*.orig
*.tmp
tmp/
temp/

# Log files
logs/
*.log
!.gitkeep

# Local database dumps (keep migration SQL files)
*.sql
*.dump
!prisma/migrations/**/*.sql

# Coverage reports (additional paths)
.nyc_output/
lcov.info

# Bundle analyzer output
.next/analyze/

# Sentry config
.sentryclirc
