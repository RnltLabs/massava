# Local Development Configuration
# Copy this to .env.local (not committed to git)

# Application URL (for QStash webhooks and email links)
# Default: http://localhost:3000 (auto-used if not set in development)
# Uncomment below if running on a different port:
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google Analytics Configuration
# Get your Measurement ID from Google Analytics 4
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
